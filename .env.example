# Development-only values. Never use these credentials outside local development.
RIBEIRA_ENV=development
RIBEIRA_API_HOST=127.0.0.1
RIBEIRA_API_PORT=8080
RIBEIRA_STORAGE=postgres
RIBEIRA_DATABASE_URL=postgresql://ribeira_app:ribeira_app_dev_only@127.0.0.1:55432/ribeira_dev
RIBEIRA_MIGRATION_DATABASE_URL=postgresql://ribeira_admin:ribeira_admin_dev_only@127.0.0.1:55432/ribeira_dev
RIBEIRA_CORS_ORIGINS=http://127.0.0.1:3000
RIBEIRA_AUTH_MODE=jwt
RIBEIRA_JWT_ISSUER=
RIBEIRA_JWT_AUDIENCE=
RIBEIRA_JWT_JWKS_URL=
RIBEIRA_JWT_PUBLIC_KEY=
RIBEIRA_DEV_AUTH_TOKEN=
RIBEIRA_DEV_AUTH_SUBJECT=local-developer
RIBEIRA_DEV_AUTH_TENANT_ID=
RIBEIRA_DEV_AUTH_ROLES=PLATFORM_ADMIN
RIBEIRA_PROVIDER_ALLOWLIST=
RIBEIRA_MAX_BODY_BYTES=1048576
