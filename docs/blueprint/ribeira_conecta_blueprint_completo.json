  "visao_geral": {
    "objetivo_principal": "Construir uma plataforma de inteligência territorial, comercial, agronômica, ambiental, de infraestrutura, conectividade, IoT e segurança que se adapte às regras de negócio da Ribeira Conecta e às regras específicas de cada cliente.",
    "objetivos_secundarios": [
      "Prospectar novos clientes de forma inteligente.",
      "Conhecer o ambiente completo do cliente antes e depois da contratação.",
      "Identificar instalações, conectividade, energia, riscos, infraestrutura e oportunidades.",
      "Criar novas linhas de consultoria para bananicultores e outros produtores.",
      "Gerar valor recorrente ao cliente com monitoramento, alertas, recomendações e automações.",
      "Transformar dados brutos em decisões e ações.",
      "Criar oportunidades de cross-sell e upsell para a Ribeira Conecta.",
      "Permitir customização por setor, cliente, propriedade, talhão, ativo e contexto.",
      "Evoluir de GIS/dashboard para uma plataforma operacional e de decisão."
    ],
    "principio_central": "Ativo -> dado -> contexto -> regra -> decisão -> ação -> resultado"
  },
