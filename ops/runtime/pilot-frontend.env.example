# Copy outside Git as ~/.config/ribeira/pilot-oidc-overrides.env (mode 600) and
# supply it only to controlled production candidate builds. Never place pilot
# tenant IDs, access tokens, or secrets in Git. The SPA client ID is a public
# identifier, not a browser secret.
VITE_RIBEIRA_AUTH_MODE=oidc
VITE_RIBEIRA_PUBLIC_ORIGIN=https://REPLACE_WITH_APPROVED_PUBLIC_ORIGIN
VITE_RIBEIRA_TENANT_ID=REPLACE_WITH_PILOT_TENANT_UUID
VITE_RIBEIRA_PROPERTY_ID=REPLACE_WITH_PILOT_PROPERTY_UUID
VITE_RIBEIRA_OIDC_AUDIENCE=REPLACE_WITH_API_AUDIENCE_IF_REQUIRED
VITE_RIBEIRA_OIDC_AUTHORIZATION_ENDPOINT=https://issuer.example/authorize
VITE_RIBEIRA_OIDC_CLIENT_ID=REPLACE_WITH_PUBLIC_SPA_CLIENT_ID
VITE_RIBEIRA_OIDC_TOKEN_ENDPOINT=https://issuer.example/oauth/token
# VITE_RIBEIRA_API_URL and VITE_RIBEIRA_OIDC_REDIRECT_URI are optional explicit
# overrides. With VITE_RIBEIRA_PUBLIC_ORIGIN set, the SPA derives /api and /.
