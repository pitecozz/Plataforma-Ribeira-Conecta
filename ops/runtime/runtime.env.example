# Copy to ~/.config/ribeira/runtime.env with mode 600. Never commit that copy.
# Values marked REPLACE are server-side secrets and must be supplied out of band.
RIBEIRA_ENV=production
RIBEIRA_STORAGE=postgres
RIBEIRA_DATABASE_URL=REPLACE_WITH_PRIVATE_DATABASE_URL
RIBEIRA_OBJECT_STORAGE_ROOT=/home/ribeira/Plataforma-Ribeira-Conecta/.local/object-storage
RIBEIRA_API_HOST=127.0.0.1
RIBEIRA_API_PORT=8080
RIBEIRA_CORS_ORIGINS=http://127.0.0.1:5173
RIBEIRA_AUTH_MODE=jwt
RIBEIRA_GEOSPATIAL_WORKER_ID=ribeira-vps-01
RIBEIRA_GEOSPATIAL_STALE_AFTER_SECONDS=3600
RIBEIRA_GEOSPATIAL_MAX_ATTEMPTS=3
