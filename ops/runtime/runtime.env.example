# Copy to ~/.config/ribeira/runtime.env with mode 600. Never commit that copy.
# Values marked REPLACE are server-side secrets and must be supplied out of band.
RIBEIRA_ENV=production
RIBEIRA_STORAGE=postgres
RIBEIRA_DATABASE_URL=REPLACE_WITH_PRIVATE_DATABASE_URL
RIBEIRA_OBJECT_STORAGE_ROOT=/home/ribeira/Plataforma-Ribeira-Conecta/.local/object-storage
RIBEIRA_API_HOST=127.0.0.1
RIBEIRA_API_PORT=8080
# The actual pilot runtime must contain the exact current public HTTPS origin.
# A Quick Tunnel hostname is temporary; no wildcard origin is permitted.
RIBEIRA_CORS_ORIGINS=REPLACE_WITH_CURRENT_HTTPS_PILOT_ORIGIN
# Production resource-server authentication.  These are identifiers/URLs, not
# client credentials.  The protected real runtime file may contain no dev token.
RIBEIRA_AUTH_MODE=oidc
RIBEIRA_JWT_ISSUER=https://issuer.example/
RIBEIRA_JWT_AUDIENCE=ribeira-api
RIBEIRA_JWT_JWKS_URL=https://issuer.example/.well-known/jwks.json
RIBEIRA_JWT_ALGORITHMS=RS256
RIBEIRA_JWKS_CACHE_TTL_SECONDS=300
RIBEIRA_JWKS_REFRESH_SECONDS=30
RIBEIRA_JWKS_TIMEOUT_SECONDS=3
RIBEIRA_GEOSPATIAL_WORKER_ID=ribeira-vps-01
RIBEIRA_GEOSPATIAL_STALE_AFTER_SECONDS=3600
RIBEIRA_GEOSPATIAL_MAX_ATTEMPTS=3
