# FUTURE_CUSTOM_DOMAIN only. Copy outside Git to
# ~/.config/ribeira/cloudflared-pilot.yml and chmod 0600 when the custom domain
# becomes available. The named-tunnel credential file is operator-held.
tunnel: REPLACE_WITH_TUNNEL_UUID
credentials-file: /home/ribeira/.config/cloudflared/REPLACE_WITH_TUNNEL_UUID.json
ingress:
  - hostname: app.ribeiraconecta.com.br
    service: http://127.0.0.1:5173
  - service: http_status:404
