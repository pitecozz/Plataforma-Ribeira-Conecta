# Copy outside Git to ~/.config/ribeira/cloudflared-pilot.yml and chmod 0600.
# The named-tunnel credential file is operator-held. Never use a quick tunnel or
# commit a tunnel token/credential JSON.
tunnel: REPLACE_WITH_TUNNEL_UUID
credentials-file: /home/ribeira/.config/cloudflared/REPLACE_WITH_TUNNEL_UUID.json
ingress:
  - hostname: app.ribeiraconecta
    service: http://127.0.0.1:5173
  - service: http_status:404
