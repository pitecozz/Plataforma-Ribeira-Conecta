[Unit]
Description=Ribeira Platform API (private loopback runtime)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ribeira/Plataforma-Ribeira-Conecta
EnvironmentFile=/home/ribeira/.config/ribeira/runtime.env
Environment=PYTHONPATH=/home/ribeira/Plataforma-Ribeira-Conecta/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ribeira/Plataforma-Ribeira-Conecta/.venv/bin/python -m ribeira_platform.api
ExecStartPost=/home/ribeira/Plataforma-Ribeira-Conecta/.venv/bin/python -m ribeira_platform.runtime_health api --wait-seconds 30
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ribeira-api

[Install]
WantedBy=default.target
